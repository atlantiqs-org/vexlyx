{
  "name": "@vexlyx/api",
  "version": "0.0.1",
  "private": true,
  "description": "Vexlyx API server (Fastify)",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc --build",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo tsconfig.tsbuildinfo",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/redis": "^9.0.0",
    "@prisma/client": "^6.9.0",
    "@vexlyx/shared": "workspace:*",
    "bullmq": "^6.3.1",
    "fastify": "^5.12.1",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "prisma": "^6.9.0"
  }
}
