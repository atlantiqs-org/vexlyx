# Vexlyx API — Environment Variables
# Copy this file to .env and fill in real values

# Server
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://vexlyx:vexlyx_dev@localhost:5432/vexlyx_dev

# Redis
REDIS_URL=redis://localhost:6379

# Auth
SESSION_SECRET=change-me-to-a-random-32-char-string-in-production
ALLOW_REGISTRATION=true

# Git Integration (F1.3)
# Root directory where cloned project repos are stored on disk.
# Dev default creates ./workspaces/projects relative to the API process.
PROJECTS_DIR=./workspaces/projects

# Root directory where per-project SSH key pairs are stored on disk.
# Dev default creates ./workspaces/keys relative to the API process.
SSH_KEYS_DIR=./workspaces/keys

# Base URL of this API — used to generate webhook callback URLs.
API_BASE_URL=http://localhost:5000

# Build Integration (F1.4)
# Prefix used for Docker image names built by Nixpacks.
# Images are named: <prefix>-<projectId>  e.g. vexlyx-cm9xyz123
# Nixpacks must be installed and available in PATH on the server.
NIXPACKS_IMAGE_PREFIX=vexlyx
