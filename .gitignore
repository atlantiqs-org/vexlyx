# Dependencies
node_modules/

# Turborepo
.turbo/

# Build outputs
dist/
.next/
out/

# TypeScript
*.tsbuildinfo

# Environment variables
.env
.env.local
.env.production
.env.*.local

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Debug logs
npm-debug.log*
pnpm-debug.log*

# Prisma (generated)
apps/api/prisma/generated/

# Docker volumes
docker/data/

# Local workspaces & generated keys (F1.3)
workspaces/
apps/api/workspaces/

# Python virtual environments & bytecode
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
apps/api/Python/

# CoreDNS generated zone database files
docker/coredns/zones/*.db
!docker/coredns/zones/.gitkeep

# Traefik SSL certificates and ACME storage
docker/traefik/acme.json
docker/traefik/certs/*.crt
docker/traefik/certs/*.key
!docker/traefik/certs/.gitkeep
