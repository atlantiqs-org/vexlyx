# Nginx site config for WordPress projects (F5.7 — official image pair).
# Generated by docker_manager.py -- do NOT edit manually.
# Proxies PHP requests to the "app" (wordpress:php8.3-fpm-alpine) service over FastCGI.

server {
    listen 80;
    listen [::]:80;
    server_name _;
    root /var/www/html;
    index index.php index.html;

    client_max_body_size 64m;

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass app:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }

    location ~* \.(jpg|jpeg|png|gif|webp|css|js|ico|svg|woff|woff2)$ {
        expires 30d;
        access_log off;
        try_files $uri =404;
    }

    location ~ /\.ht {
        deny all;
    }
}
